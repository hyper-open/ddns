# 复制为 ddns.toml 并填写。密钥请放在 .env（见 .env.example），不要写在这里。

[ddns]
# 服务商: tencent | aliyun | cloudflare | huawei
provider = "tencent"
# 检测间隔（秒）
check_interval = 60
# 日志级别: DEBUG | INFO | WARNING | ERROR
log_level = "INFO"
# 可选：覆盖状态文件路径（相对路径相对本文件所在目录，默认 ddns_state.json）
# state_file = "ddns_state.json"

# 公共默认值（可被每条记录覆盖）
domain = "example.com"
record_type = "AAAA"
ttl = 600
sub_domain = ""

# ===== 记录列表 =====
# 一个进程探测一次 IP，扇出更新下面所有记录（同一服务商）。
# 若省略 [[records]]，则用上面 [ddns] 的 domain/sub_domain 作为单条记录。

[[records]]
domain = "example.com"
sub_domain = "home"
record_type = "AAAA"

[[records]]
domain = "example.com"
sub_domain = "www"
record_type = "A"
ttl = 300

# [[records]]
# domain = "other.com"
# sub_domain = "@"          # 根域名用 @ 或留空
# record_type = "AAAA"

# ===== 各服务商选项（只保留所选服务商的段）=====

# 腾讯云 DNSPod：无额外选项
[tencent]

# 阿里云云解析：region 用于推导 endpoint（默认 cn-hangzhou）
[aliyun]
region = "cn-hangzhou"

# Cloudflare：zone_id 可选，填了则跳过 zone 查询；proxied 仅对 A 记录生效
[cloudflare]
# zone_id = "023e105f4ecef8ad9ca31a8372d0c353"
proxied = false

# 华为云 DNS：region 必填
[huawei]
region = "cn-north-4"
