# 复制为 .env 并填写。只校验所选服务商对应的凭据。

# ===== 通用 =====
# 服务商: dnspod | aliyun | cloudflare | huawei
DDNS_PROVIDER=dnspod
# 记录类型: AAAA(IPv6) | A(IPv4)
DDNS_RECORD_TYPE=AAAA
# 主域名
DDNS_DOMAIN=example.com
# 主机记录前缀；如 home.example.com 填 home，根域名填 @ 或留空
DDNS_SUB_DOMAIN=home
DDNS_TTL=600
# 检测间隔（秒）
DDNS_CHECK_INTERVAL=60
# 可选：覆盖状态文件路径（默认 ddns_state.json）
# DDNS_STATE_FILE=
# 日志级别: DEBUG | INFO | WARNING | ERROR
DDNS_LOG_LEVEL=INFO

# ===== 腾讯云 DNSPod =====
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ===== 阿里云云解析 =====
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-hangzhou

# ===== Cloudflare =====
CLOUDFLARE_API_TOKEN=
# 可选：已知道 zone id 时填写，跳过 zone 查询
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PROXIED=false

# ===== 华为云 DNS =====
HUAWEI_ACCESS_KEY_ID=
HUAWEI_SECRET_ACCESS_KEY=
HUAWEI_REGION=cn-north-4
