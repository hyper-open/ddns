# 复制为 .env 并填写密钥。非敏感配置在 ddns.toml 中。
# 只需填写你所用 provider 对应的变量，其余留空即可。

# 腾讯云 DNSPod
TENCENT_ACCESS_KEY_ID=
TENCENT_ACCESS_KEY_SECRET=

# 阿里云云解析
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Cloudflare（建议用仅 DNS 权限的 API Token）
CLOUDFLARE_API_TOKEN=

# 华为云 DNS
HUAWEI_ACCESS_KEY_ID=
HUAWEI_ACCESS_KEY_SECRET=
